# ============================================================
#  Empire-X AI Calling Platform - Environment Variables
#  Copy this file to .env and fill in your keys
# ============================================================

# Required - Groq API key (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional - Twilio telephony (only needed for Twilio calling mode)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# TWILIO_BASE_URL=http://localhost:8001

# TTS server (edge-tts, run: python backend/tts_server.py)
TTS_API_URL=http://localhost:8000/tts
TTS_API_KEY=emx_your_tts_key

# LLM model (faster options: llama-3.1-8b-instant, allam-2-7b)
LLM_MODEL=llama-3.1-8b-instant

# ============================================================
#  VICIdial Integration Settings (optional)
#  Required only for VICIdial auto-dialer + AI agent integration
# ============================================================
# VICIDIAL_API_URL=http://YOUR_VICIDIAL_SERVER/vicidial/non_agent_api.php
# VICIDIAL_API_USER=6666
# VICIDIAL_API_PASS=api_pass
# VICIDIAL_AGENT_USER=AI_AGENT_01
# VICIDIAL_AGENT_PASS=agent_pass
# VICIDIAL_CAMPAIGN_ID=AI_CAMPAIGN
# VICIDIAL_DEFAULT_QUEUE=200
# VICIDIAL_SERVER_IP=10.0.0.1
# EMPIRE_CALLBACK_URL=http://YOUR_EMPIRE_SERVER:8002/api/vicidial/callback
# EMPIRE_CALLBACK_KEY=empire_secret_callback_key
